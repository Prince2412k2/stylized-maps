#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_pbf="${MAP_OSM_SOURCE:?MAP_OSM_SOURCE is required}"
asset_root="${MAP_ASSET_ROOT:?MAP_ASSET_ROOT is required}"
planetiler="${MAP_PLANETILER_JAR:?MAP_PLANETILER_JAR is required}"
next_archive="${MAP_VECTOR_OUTPUT:?MAP_VECTOR_OUTPUT is required}"

test -f "$source_pbf" || { printf 'Missing %s. Run the asset acquisition stage first.\n' "$source_pbf" >&2; exit 1; }
test -f "$planetiler" || { printf 'Missing %s. Run the asset acquisition stage first.\n' "$planetiler" >&2; exit 1; }

trap 'rm -f "$next_archive"' EXIT
mkdir -p "$(dirname "$next_archive")"

docker run --rm \
  --cpus "${MAP_CPU_LIMIT:-4}" \
  --memory "${MAP_MEMORY_LIMIT_GB:-16}g" \
  --memory-swap "${MAP_MEMORY_SWAP_LIMIT_GB:-18}g" \
  --label "map.pipeline=${MAP_BUILD_ID:-india-vector}" \
  --user "$(id -u):$(id -g)" \
  --volume "$root:/workspace" \
  --volume "$asset_root:/assets" \
  --workdir /workspace \
  --env JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:--Xmx24g}" \
  --env MAP_OSM_SOURCE="/assets/${source_pbf#$asset_root/}" \
  --env MAP_VECTOR_OUTPUT="/assets/${next_archive#$asset_root/}" \
  eclipse-temurin:22-jdk \
  sh -c 'mkdir -p /tmp/classes /tmp/planetiler && javac -proc:none -cp /assets/planetiler/planetiler.jar -d /tmp/classes planetiler/*.java && java -cp /assets/planetiler/planetiler.jar:/tmp/classes IndiaPoc --force --tmpdir=/tmp/planetiler'

trap - EXIT
printf 'Built India vector product %s\n' "$next_archive"
